# =============================================================================
# deepSTRF-specific
# =============================================================================

# --- Claude Code / local-only assistant files (NEVER push) ---
/CLAUDE.md
/NEXT_PROMPT.md
/IDEAS.md
.claude/

# --- Paper drafts and supplementary (NEVER push) ---
/deepSTRF_paper_draft.pdf
*paper_draft*
/paper/
/paper_figures/

# --- Raw & preprocessed dataset data (NEVER push, hosted on CRCNS/OSF/Zenodo/Dryad) ---
# Any 'data/' subdirectory anywhere under the datasets tree.
deepSTRF/datasets/**/data/
# Dataset-host README PDFs that live next to the data dirs.
deepSTRF/datasets/**/*-readme.pdf
deepSTRF/datasets/**/*_readme.pdf
deepSTRF/datasets/**/ReadMe.*
# Stray preprocessed dumps occasionally produced by preprocessing scripts.
deepSTRF/datasets/**/*.pt

# --- Data file extensions (neural recordings / spectrograms / archives) ---
*.pt
*.pth
*.npy
*.npz
*.mat
*.h5
*.hdf5
